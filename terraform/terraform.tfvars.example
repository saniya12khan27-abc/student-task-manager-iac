# ==============================================================================
# Example Terraform Variables File
# Copy this file to 'terraform.tfvars' and insert your Cloudflare credentials.
# Note: 'terraform.tfvars' is gitignored to protect sensitive credentials.
# ==============================================================================

cloudflare_account_id = "your_cloudflare_account_id_here"
cloudflare_api_token  = "your_cloudflare_api_token_here"

worker_name        = "student-task-manager"
kv_namespace_name  = "student_tasks"
environment        = "production"
